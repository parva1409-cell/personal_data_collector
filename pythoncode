print("Personal Data Collector")

name = input("Enter your name: ")
age = int(input("Enter your age: "))
height = float(input("Enter your height in meters: "))
favourite_number = int(input("Enter your favourite number: "))

# Calculate birth year
current_year = 2026
birth_year = current_year - age

# Convert height from float to int
height_int = int(height)

print("\nYour Information")

print("\nName:", name)
print("Type:", type(name))
print("ID:", id(name))

print("\nAge:", age)
print("Type:", type(age))
print("ID:", id(age))

print("\nHeight:", height, "meters")
print("Type:", type(height))
print("ID:", id(height))

print("\nFavourite Number:", favourite_number)
print("Type:", type(favourite_number))
print("ID:", id(favourite_number))

print("\nYour approximate birth year is:", birth_year)

print("\nType Conversion")
print("Original height:", height, "Type:", type(height))
print("Height after conversion:", height_int, "Type:", type(height_int))

print("\nThank you for using the program!")
